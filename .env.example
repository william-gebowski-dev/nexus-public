# Variáveis para o endpoint /api/changelog/send (Vercel Cron 23:30 UTC).
#
# NÃO commitar valores reais — configurar no painel da Vercel.
# Este arquivo serve só como documentação dos nomes esperados.

# URL completa do POST do Hermes Agent (bot Telegram vive lá).
HERMES_AGENT_URL=https://hermes-agent.exemplo/notify

# Segredo HMAC compartilhado com o Hermes Agent. Usado para assinar
# `${timestamp}.${rawBody}` (x-nexus-signature). Mesmo padrão de
# AI_INGEST_SECRET e SYSTEM_STATUS_SECRET.
HERMES_AGENT_API_KEY=segredo-trocar

# Opcional: listar commits via GitHub API em vez de git local.
# Útil em deploy Vercel (sem clone completo do repo).
GITHUB_TOKEN=ghp_trocar
GITHUB_REPO=william-gebowski-dev/nexus-dashboard
